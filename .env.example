# Groq powers routing, generation, grading, query rewriting, and the web
# fallback. Get a free key at https://console.groq.com
# You can also paste the key directly into the app sidebar instead.
GROQ_API_KEY=gsk_your_groq_api_key

# Optional: override the chat model (default: openai/gpt-oss-120b).
# Useful for quota management during long evaluation runs.
# RAG_MODEL=openai/gpt-oss-20b

# Optional: persist the vector store to disk instead of in-memory.
# QDRANT_PATH=./.qdrant
